---
/**
 * Answers mirror the visible copy below, condensed to plain text for schema.
 * Google retired FAQ rich results for most sites in 2023, so this is not an SEO
 * play — it just gives answer engines the shipping/returns/refunds policy as
 * clean question-and-answer pairs. If you edit the copy below, edit these too.
 */
const FAQ_ITEMS = [
  {
    question: 'Shipping',
    answer:
      'Orders ship same day or next working day (some digital prints are printed upon order). Standard delivery applies. Rates are calculated at checkout. Estimated delivery times: 2–7 days for BG, RO, GR, HU, CZ, HR, SI, SK and PL; 5–9 days for the rest of Europe; 8–14 days for USA, Canada and Australia; 10–15 days for other regions. Times are estimates. Delays may occur due to carriers or customs. Import duties and taxes are the customer\'s responsibility. Only applies to physical products.',
  },
  {
    question: 'Returns',
    answer:
      'Returns accepted within 30 days of delivery. Items must be unused, undamaged, and in original packaging with proof of purchase. Email hi@iam314.com to request a return. Unapproved returns are not accepted. Return shipping is paid by the customer. Digital products, custom items, and gift cards are non-returnable. Damaged or incorrect items must be reported immediately.',
  },
  {
    question: 'Refunds',
    answer:
      'Refunds are issued after inspection of the returned item. Processing times vary by payment provider. Only applies to physical products.',
  },
];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ_ITEMS.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
});
---

<section class="wrap">
  <script type="application/ld+json" is:inline set:html={faqJsonLd} />
  <div class="grid">
    <div class="txt-item faq-grid">
      <div class="faq-item">
        <h2 class="txt-s">Shipping</h2><br>
        <p class="paragraph1 paragraph1-s">Orders ship same day or next working day (some digital prints are printed upon order). Standard delivery applies. Rates are calculated at checkout.</p>
        <br>
        <h3 class="txt-s">Estimated delivery times</h3><br>
        <p class="paragraph1 paragraph1-s">
          2–7 days: BG, RO, GR, HU, CZ, HR, SI, SK, PL<br>
          5–9 days: Rest of Europe<br>
          8–14 days: USA, Canada, Australia<br>
          10–15 days: Other regions
        </p><br>
        <p class="paragraph1 paragraph1-s">Times are estimates. Delays may occur due to carriers or customs. Import duties and taxes are the customer's responsibility.</p><br>
        <p class="paragraph1 paragraph1-s">*Only for physical products.</p>
      </div>
      <div class="faq-item">
        <h2 class="txt-s">Returns</h2><br>
        <p class="paragraph1 paragraph1-s">
          Returns accepted within 30 days of delivery. Items must be unused, undamaged, and in original packaging with proof of purchase.
          Email <a href="mailto:hi@iam314.com" class="contact-link">hi@iam314.com</a> to request a return. Unapproved returns are not accepted.
        </p>
        <br>
        <p class="paragraph1 paragraph1-s">Return shipping is paid by the customer. Digital products, custom items, and gift cards are non-returnable.</p>
        <br>
        <p class="paragraph1 paragraph1-s">Damaged or incorrect items must be reported immediately.</p>
      </div>
      <div class="faq-item">
        <h2 class="txt-s">Refunds</h2><br>
        <p class="paragraph1 paragraph1-s">Refunds are issued after inspection of the returned item. Processing times vary by payment provider.</p><br>
        <p class="paragraph1 paragraph1-s">*Only for physical products.</p>
      </div>
    </div>
  </div>
</section>
