---
/**
 * Expandable project description, in the spirit of a case-study "Read about the
 * project" toggle. Native button + aria-expanded/aria-controls, with the panel
 * animated open with grid-template-rows (no JS measurement).
 *
 * Drop it into a work page's hero and pass the copy as the default slot:
 *
 *   <ProjectAbout label="Read about the project">
 *     <p class="paragraph1">…</p>
 *     <p class="paragraph1">…</p>
 *   </ProjectAbout>
 */
interface Props {
  /** Button text. */
  label?: string;
  /** Start expanded (mainly for testing / anchor links). */
  open?: boolean;
}

const { label = 'Read about the project', open = false } = Astro.props;

const panelId = `project-about-${crypto.randomUUID().slice(0, 8)}`;
---

<div class:list={['project-about', { 'is-open': open }]} data-project-about>
  <button
    type="button"
    class="project-about-toggle"
    aria-expanded={open ? 'true' : 'false'}
    aria-controls={panelId}
  >
    <span class="project-about-label">{label}</span>
    <span class="project-about-icon" aria-hidden="true"></span>
  </button>

  <div class="project-about-panel" id={panelId}>
    <div class="project-about-inner">
      <div class="project-about-content">
        <slot />
      </div>
    </div>
  </div>
</div>

<style>
  .project-about {
    margin-top: 2rem;
  }

  .project-about-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: 0.02em;
    cursor: pointer;
  }

  .project-about-label {
    padding-bottom: 0.1em;
    border-bottom: 1px solid currentColor;
    transition: opacity 0.25s ease-in-out;
  }

  .project-about-toggle:hover .project-about-label,
  .project-about-toggle:focus-visible .project-about-label {
    opacity: 0.5;
  }

  /* Plus that becomes a minus. */
  .project-about-icon {
    position: relative;
    flex: none;
    width: 0.7em;
    height: 0.7em;
  }

  .project-about-icon::before,
  .project-about-icon::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: currentColor;
  }

  .project-about-icon::before {
    width: 100%;
    height: 1px;
  }

  .project-about-icon::after {
    width: 1px;
    height: 100%;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .is-open .project-about-icon::after {
    transform: scaleY(0);
  }

  /* 0fr -> 1fr animates the height without measuring it. */
  .project-about-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-about-inner {
    overflow: hidden;
    /* Hidden from the a11y tree while collapsed, but only after the collapse
       animation has run. */
    visibility: hidden;
    transition: visibility 0s linear 0.45s;
  }

  .is-open .project-about-panel {
    grid-template-rows: 1fr;
  }

  .is-open .project-about-inner {
    visibility: visible;
    transition-delay: 0s;
  }

  .project-about-content {
    padding-top: 1.75rem;
    max-width: 62ch;
  }

  /* Let callers just drop plain paragraphs and have them spaced. */
  .project-about-content :global(p) {
    font-size: clamp(1rem, 0.986rem + 0.07vw, 1.05rem);
    line-height: 1.6;
    letter-spacing: 0.02em;
  }

  .project-about-content :global(p + p) {
    margin-top: 1em;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-about-panel,
    .project-about-inner,
    .project-about-icon::after {
      transition: none;
    }
  }
</style>

<script>
  // Toggles every instance in place; runs on each full page load (the site does
  // not use client-side navigation).
  document.querySelectorAll<HTMLElement>('[data-project-about]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('.project-about-toggle');
    if (!button) return;

    button.addEventListener('click', () => {
      const isOpen = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!isOpen));
      root.classList.toggle('is-open', !isOpen);
    });
  });
</script>
