---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cta from '../../components/CTA.astro';

const meta = {
  title: "Brand Springboard — Brand Identity & Website by Lyudmil Dachev",
  description: "Brand identity and website for Brand Springboard, a marketing company bridging creatives and marketing experts. Logo system, visual language, and web design and webflow build by Lyudmil Dachev.",
  link: "https://www.iam314.com/work/brand-springboard/",
  ogImage: "/images/ogimages/Open Graph - Brand springboard.png",
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  link={meta.link}
  ogImage={meta.ogImage}
  schemaType="case-study"
  footerVariant="photoOnly"
>
  <section class="wrap">
    <div class="grid">
      <div class="inner-projects-hero hero-grid projects-top-reset">
        <h1 class="txt-xl">Brand Springboard</h1>
        <h2 class="subtxt">Identity & website</h2>
          <ul class="labels">
            <li class="labels subtxtgray">Logo design</li>
            <li class="labels subtxtgray">Identity</li>
            <li class="labels subtxtgray">Web design</li>
            <li class="labels subtxtgray">Development</li>
            <li class="labels subtxtgray">Webflow</li>
          </ul>
        <!-- <p class="labels subtxtgray">Logo Design / Identity / Web Design / Development / Webflow</p> -->
      </div>
    </div>
  </section>
  <section class="wrap">
    <div class="grid inner-projects-hero marging-reset">
      <div class="projects-grid">
        <div class="grid-1">

          <figure>
            <lottie-player class="img-responsive"
              src="/images/work/brand-springboard/brand-springboard_logo-animation.json" 
              background="transparent" 
              speed="1" 
              loop 
              autoplay 
              role="img" 
              width="3840" 
              height="2160" 
              aria-label="Animated Brand Springboard logo by Lyudmil Dachev">
            </lottie-player>
            <figcaption class="visually-hidden">A smooth loop animation of the Brand Springboard logo.</figcaption>
          </figure>

          <div class="grid-2">
            <figure>
              <img class="img-responsive"src="/images/work/brand-springboard/brand-springboard_logo-onlight.avif" alt="Brand Springboard primary logo design on light background by Lyudmil Dachev"
              loading="lazy" width="2560" height="1440">
              <figcaption class="visually-hidden">The primary logo for Brand Springboard on light background</figcaption>
            </figure>
            <figure>
            <img class="img-responsive"src="/images/work/brand-springboard/brand-springboard_logo-ondark.avif"alt="Brand Springboard primary logo design on dark background by Lyudmil Dachev"
              loading="lazy" width="2560" height="1440">
              <figcaption class="visually-hidden">The primary logo for Brand Springboard on dark background</figcaption>
            </figure>
          </div>
          <div class="grid-4">
            <figure>
              <img class="img-responsive" 
                  src="/images/work/brand-springboard/brand-springboard_icon-black.avif" 
                  alt="Black icon design for Brand Springboard by Lyudmil Dachev" 
                  loading="lazy" width="1080" height="1080">
              <figcaption class="visually-hidden">Brand Springboard icon variation in solid black.</figcaption>
            </figure>

            <figure>
              <img class="img-responsive" 
                  src="/images/work/brand-springboard/brand-springboard_icon-blue.avif" 
                  alt="Blue icon design for Brand Springboard by Lyudmil Dachev" 
                  loading="lazy" width="1080" height="1080">
              <figcaption class="visually-hidden">Brand Springboard icon variation in brand blue.</figcaption>
            </figure>

            <figure>
              <img class="img-responsive" 
                  src="/images/work/brand-springboard/brand-springboard_icon-onblue.avif" 
                  alt="Brand Springboard icon in white on a blue background" 
                  loading="lazy" width="1080" height="1080">
              <figcaption class="visually-hidden">Brand Springboard icon variation inverted on a blue background.</figcaption>
            </figure>

            <figure>
              <img class="img-responsive" 
                  src="/images/work/brand-springboard/brand-springboard_icon-onblack.avif" 
                  alt="Brand Springboard icon in white on a black background" 
                  loading="lazy" width="1080" height="1080">
              <figcaption class="visually-hidden">Brand Springboard icon variation inverted on a black background.</figcaption>
            </figure>
          </div>
          <div>
            <figure>
              <img class="img-responsive" 
                  src="/images/work/brand-springboard/brand-springboard_typography.avif" 
                  alt="Typography system and font selection for Brand Springboard by Lyudmil Dachev" 
                  loading="lazy" width="2560" height="1440">
              <figcaption class="visually-hidden">
                A showcase of the brand's typography, detailing the primary and secondary typefaces used across the Brand Springboard identity.
              </figcaption>
            </figure>
          </div>
          <div>
            <figure>
              <img class="img-responsive" 
                  src="/images/work/brand-springboard/brand-springboard_merch.avif" 
                  alt="Brand Springboard stationery and merchandise design by Lyudmil Dachev" 
                  loading="lazy" width="2560" height="1440">
              <figcaption class="visually-hidden">
                A collection of brand touchpoints, including stationery and merchandise, demonstrating the Brand Springboard visual identity in physical applications.
              </figcaption>
            </figure>
          </div>
          <div>
            <figure>
              <img class="img-responsive" 
                  src="/images/work/brand-springboard/brand-springboard_pattern.avif" 
                  alt="Custom geometric brand pattern for Brand Springboard by Lyudmil Dachev" 
                  loading="lazy" width="2560" height="1164">
              <figcaption class="visually-hidden">
                A custom-designed geometric pattern derived from the springboard logo mark, used as a secondary visual element for the Brand Springboard identity.
              </figcaption>
            </figure>
          </div>    
          <div>
            <figure>
              <img class="img-responsive" 
                  src="/images/work/brand-springboard/brand-springboard_website.avif" 
                  alt="Desktop UI/UX design and Webflow development for Brand Springboard by Lyudmil Dachev" 
                  loading="lazy" width="2560" height="2248">
              <figcaption class="visually-hidden">
                The desktop website interface for Brand Springboard, showcasing the integration of brand colors, typography, and minimalist layout in a digital environment.
              </figcaption>
            </figure>
          </div>    
          <div>
            <figure>
              <img class="img-responsive" 
                  src="/images/work/brand-springboard/brand-springboard_website-mobile.avif" 
                  alt="Responsive mobile UI design for the Brand Springboard website by Lyudmil Dachev" 
                  loading="lazy" width="2560" height="915">
              <figcaption class="visually-hidden">
                The optimized mobile interface for Brand Springboard, demonstrating how the minimalist design system adapts to smaller screens for a seamless user experience.
              </figcaption>
            </figure>
          </div>                                    
          <div>
            <figure>
              <video 
                width="1920" 
                height="1080" 
                preload="auto" 
                autoplay 
                loop 
                muted 
                playsinline 
                poster="/images/work/brand-springboard/brand-springboard_website.avif" 
                class="project-video img-responsive">
                <source src="/images/work/brand-springboard/brand-springboard_website_v1 (1080p).mp4" type="video/mp4">
                Your browser does not support the video tag.
              </video>
              <figcaption class="visually-hidden">
                A screen recording of the Brand Springboard website showcasing smooth transitions, minimalist UI interactions, and responsive Webflow animations.
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </div>
  </section>

<!-- up next -->
  <section class="wrap">
    <a href="/work/workship/" class="upnext-link">
    <div class="grid">
      <div class="inner-projects-hero hero-grid projects-top-reset">
        <h3 class="subtxt subtxtgray">up next</h3>
        <h4 class="txt-xl">Workship</h4>
        <h5 class="subtxt">Identity</h5>
          <ul class="labels">
            <li class="labels subtxtgray">Logo design</li>
            <li class="labels subtxtgray">Identity</li>
          </ul>

      </div>
    </div>

    <div class="grid inner-projects-hero marging-reset">
      <div class="projects-grid" style="padding-bottom: 0;">
        <div class="grid-1">

          <div>
            <figure class="upnext-img">
            <img class="img-responsive" src="/images/work/workship/workship_logo_black_white.avif" 
                alt="Workship custom wordmark and logo design by Lyudmil Dachev" 
                loading="lazy" width="2561" height="1600">
            <figcaption class="visually-hidden">
              The primary custom wordmark for Workship, featuring high-contrast minimalist custom typography.
            </figcaption>
            </figure>
          </div>                                         

        </div>
      </div>
    </div>
    </a>
  </section>
<!-- end of upnext -->

<Cta />
</BaseLayout>