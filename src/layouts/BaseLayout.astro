---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import type { ProductSchema } from '../data/productPages';
import { assetVersion } from '../utils/assetVersion';

// Versioned so a CSS/JS change is picked up immediately instead of being served
// from cache. See src/utils/assetVersion.ts.
const vNormalize = assetVersion('css/normalize.css');
const vLyudmils = assetVersion('css/lyudmils.css');
const vScripts = assetVersion('js/lyudmils.js');

interface Props {
  title: string;
  description: string;
  link: string;
  ogImage: string;
  schemaType?: 'base' | 'case-study' | 'product';
  price?: string;
  availability?: string;
  product?: ProductSchema;
  useSwiper?: boolean;
  footerVariant?: 'home' | 'inner' | 'photoOnly';
}

const {
  title,
  description,
  link,
  ogImage,
  schemaType = 'base',
  price,
  availability,
  product,
  useSwiper = false,
  footerVariant = 'home',
} = Astro.props;
---

<!DOCTYPE html>
<!-- Designed and developed by Lyudmil Dachev -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{title}</title>
  <link rel="canonical" href={link} />
  <meta name="description" content={description} />
  <meta name="author" content="Lyudmil Dachev">
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={'https://www.iam314.com' + ogImage} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={'https://www.iam314.com' + ogImage} />
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {/*
    Third-party origins. All three are requested on every page: jsdelivr serves
    Lenis (and Swiper on store pages), Google serves gtag, Payhip serves the cart.
    Preconnecting overlaps their DNS + TCP + TLS with our own loading.

    No `crossorigin` here, because these are loaded as plain stylesheets and
    scripts. A crossorigin preconnect would open a separate connection that the
    non-CORS requests would never reuse.
  */}
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="preconnect" href="https://www.googletagmanager.com">
  <link rel="preconnect" href="https://payhip.com">

  {/*
    The body font is render-critical but is only discovered once lyudmils.css has
    downloaded and been parsed, so without this the font sits at the end of a
    waterfall. Preloading starts it alongside the stylesheets.

    `crossorigin` is required even though the font is same-origin: font fetches
    are always CORS-mode, and a preload that does not match is discarded and the
    font is downloaded twice. For the same reason the href must match the
    @font-face URL exactly — hence no ?v= here, since the CSS requests the bare path.
  */}
  <link rel="preload" href="/fonts/ABCArealVariable.woff2" as="font" type="font/woff2" crossorigin>

  <link href={`/css/normalize.css?v=${vNormalize}`} rel="stylesheet" type="text/css">
  <link href={`/css/lyudmils.css?v=${vLyudmils}`} rel="stylesheet" type="text/css">
  {/* nandr.css is only used by /niceandrandom/ and is loaded there. */}
  <slot name="head" />
  <link href="/images/favicon.png" rel="shortcut icon" type="image/x-icon">
  <link href="/images/webclip.png" rel="apple-touch-icon">

  <!-- EXPERIMENT: Lenis smooth scroll -->
  <link href="https://cdn.jsdelivr.net/npm/lenis@1.3.26/dist/lenis.css" rel="stylesheet">
  <style is:inline>
    /* Lenis needs the native smooth-scroll declaration turned off while it drives the page */
    html.lenis, html.lenis body { height: auto; }
    .lenis.lenis-smooth { scroll-behavior: auto !important; }
  </style>
  <script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.3.26/dist/lenis.min.js" defer></script>
  <script is:inline>
    // EXPERIMENT: Lenis smooth scroll. Remove this block + the tags above to revert.
    document.addEventListener('DOMContentLoaded', function () {
      if (!window.Lenis) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var lenis = new Lenis({
        autoRaf: true,   // built-in requestAnimationFrame loop
        anchors: true,   // smooth-scroll same-page anchor links
      });

      window.lenis = lenis; // handy for poking at it from the console
    });
  </script>
  <JsonLd {title} {description} {link} {ogImage} schemaType={schemaType} price={price} availability={availability} product={product} />
  <script is:inline src={`/js/lyudmils.js?v=${vScripts}`} defer></script>

  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8K5NWXN6WD"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-8K5NWXN6WD');
  </script>

  <!-- STORE -->
  <script is:inline>
    var PayhipConfig = { enableCart: true };
  </script>
  <script is:inline src="https://payhip.com/payhip.js" defer></script>

  {useSwiper && (
    <>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.css" />
      <script is:inline src="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.js" defer></script>
    </>
  )}
</head>
<body class="body-light">
  <Nav />
  <main>
    <slot />
  </main>
  <Footer variant={footerVariant} />
</body>
</html>
