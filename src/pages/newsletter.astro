---
import BaseLayout from '../layouts/BaseLayout.astro';

const meta = {
  title: 'Newsletter — New Work & Limited Releases by Lyudmil Dachev',
  description:
    'Subscribe for infrequent updates on new art prints, type releases, and selected work by Lyudmil Dachev — plus notes on process. No spam, no schedule.',
  link: 'https://www.iam314.com/newsletter/',
  ogImage: '/images/ogimages/og-newsletter.png',
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  link={meta.link}
  ogImage={meta.ogImage}
  footerVariant="inner"
>
  <section class="wrap hero">
    <div class="grid">
      <div class="hero_wrap hero-grid">
        <h1 class="txt-xl">New work and<br>limited releases.</h1>
        <p class="subtxt subtxtgray">Infrequent emails announcing new art prints, type releases, and selected work. Occasionally, I share short notes and the process behind the work.</p>
        <form
          action="https://app.kit.com/forms/8948137/subscriptions"
          class="seva-form formkit-form name"
          method="post"
          data-sv-form="8948137"
          data-uid="0f8318305e"
          data-format="inline"
          data-version="5"
          data-options='{"settings":{"after_subscribe":{"action":"message","success_message":"You’re in. I’ll email when new work is released.","redirect_url":""},"analytics":{"google":null,"fathom":null,"facebook":null,"segment":null,"pinterest":null,"sparkloop":null,"googletagmanager":null},"modal":{"trigger":"timer","scroll_percentage":null,"timer":5,"devices":"all","show_once_every":15},"powered_by":{"show":true,"url":"https://kit.com/features/forms?utm_campaign=poweredby&utm_content=form&utm_medium=referral&utm_source=dynamic"},"recaptcha":{"enabled":true},"return_visitor":{"action":"show","custom_content":""},"slide_in":{"display_in":"bottom_right","trigger":"timer","scroll_percentage":null,"timer":5,"devices":"all","show_once_every":15},"sticky_bar":{"display_in":"top","trigger":"timer","scroll_percentage":null,"timer":5,"devices":"all","show_once_every":15}},"version":"5"}'
          min-width="400 500 600 700 800"
        >
          <div data-style="clean">
            <!-- Error Messages -->
            <ul class="formkit-alert formkit-alert-error" data-element="errors" data-group="alert"></ul>

            <!-- Form Fields -->
            <div data-element="fields" data-stacked="false" class="seva-fields formkit-fields">
              <!-- Email Input Field -->
              <div class="formkit-field">
                <input
                  class="formkit-input"
                  name="email_address"
                  aria-label="Email address"
                  placeholder="Email address"
                  required=""
                  type="email"
                >
              </div>

              <!-- Submit Button -->
              <button
                data-element="submit"
                class="formkit-submit formkit-submit"
              >
                <div class="formkit-spinner">
                  <div></div>
                  <div></div>
                  <div></div>
                </div>
                <span class="">Subscribe</span>
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>
  <script is:inline src="https://f.convertkit.com/ckjs/ck.5.js"></script>
</BaseLayout>
