---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';

const meta = {
  title: "The kiss – Limited Edition Screen Print by Lyudmil Dachev",
  description: "The kiss is a limited edition hand-pulled screen print by Lyudmil Dachev. Edition of 9, signed and numbered, 40×50 cm. Ships worldwide.",
  link: "https://www.iam314.com/store/kiss-print/",
  ogImage: "/images/ogimages/Open Graph - The kiss.png",
  price: "40",
  availability: "https://schema.org/SoldOut",
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  link={meta.link}
  ogImage={meta.ogImage}
  schemaType="product"
  price={meta.price}
  availability={meta.availability}
  useSwiper
  footerVariant="inner"
>
    <section class="wrap inner-store-hero">
      <div class="grid">
        <div class="productgallery-grid">
          <div class="product-gallery">
            <!-- Thumbnail slider -->
            <div class="swiper product-thumbs">
              <div class="swiper-wrapper">
                <div class="swiper-slide">
                  <img src="/images/store/thekiss/thekiss-1.avif" alt="The Kiss print thumbnail" loading="lazy">
                </div>
                <div class="swiper-slide">
                  <img src="/images/store/thekiss/thekiss-2.avif" alt="The Kiss detail 1 thumbnail" loading="lazy">
                </div>
                <div class="swiper-slide">
                  <img src="/images/store/thekiss/thekiss-3.avif" alt="The Kiss detail 2 thumbnail" loading="lazy">
                </div>
              </div>
            </div>
            <!-- Main slider -->
            <div class="swiper product-main">
              <div class="swiper-wrapper">
                <div class="swiper-slide">
                  <img src="/images/store/thekiss/thekiss-1.avif" alt="The Kiss print" loading="lazy">
                </div>
                <div class="swiper-slide">
                  <img src="/images/store/thekiss/thekiss-2.avif" alt="The Kiss detail 1" loading="lazy">
                </div>
                <div class="swiper-slide">
                  <img src="/images/store/thekiss/thekiss-3.avif" alt="The Kiss detail 2" loading="lazy">
                </div>
              </div>
            </div>
          </div>
        </div>      
        <div class="productdecription-grid">
          <h1 class="txt-l">The kiss</h1>
          <p class="txt-s"><span style="text-decoration: line-through;">€40</span> SOLD OUT</p>
          <p class="subtxtgray">Hand pulled screen print</p>
          <p class="paragraph1">This print is original artwork, hand-printed by Lyudmil Dachev. Limited edition run of 9 posters. All signed and numbered.<br>
          Dimensions: 40x50 centimeters / 15.748x19.685 inch</p>
          <!-- <div class="buttons">
            <a href="https://payhip.com/ad2Xl?redirect=https://iam314.com/thank-you.html"
              class="add-btn payhip-add-to-cart-button"
              data-theme="none"
              data-product="ad2Xl">
              Add to cart
            </a>
            <button type="button"
              class="buy-btn buy-now-btn"
              data-product="ad2Xl"
              data-message="Thanks for buying The kiss print!"
              data-title="The kiss – limited edition print"
            >Buy
            </button>
          </div> -->
        </div>
      </div>
    </section>
<Faq />

<!-- STORE -->
  <script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".buy-now-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        Payhip.Checkout.open({
          product: btn.dataset.product,
          method: "overlay",
          message: btn.dataset.message,
          title: btn.dataset.title,
          successUrl: "https://iam314.com/thanks/"
        });
      });
    });
  });
  </script>

<!-- SWIPER -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    // Thumbnails
const thumbsSwiper = new Swiper('.product-thumbs', {
  spaceBetween: 8,
  freeMode: true,
  watchSlidesProgress: true,

  // default (desktop)
  direction: 'vertical',
  slidesPerView: 'auto',

  breakpoints: {
    0: {
      direction: 'horizontal',
      slidesPerView: 'auto'
    },
    767: {
      direction: 'vertical',
      slidesPerView: 'auto'
    }
  }
});

    // Main slider with thumbs
    const mainSwiper = new Swiper('.product-main', {
      spaceBetween: 16,
      loop: true,
      grabCursor: true,
      thumbs: {
        swiper: thumbsSwiper
      }
    });
  });
</script>
</BaseLayout>
