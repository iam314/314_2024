---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cta from '../../components/CTA.astro';

const meta = {
  title: "The R&B Awards — Brand Identity & Website by Lyudmil Dachev",
  description: "Brand identity and Webflow website for The R&B Awards, a music awards show celebrating rhythm and blues. Logo system, visual identity, and web design by Lyudmil Dachev.",
  link: "https://www.iam314.com/work/the-rnb-awards/",
  ogImage: "/images/ogimages/og-the-rnb-awards.png",
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  link={meta.link}
  ogImage={meta.ogImage}
  schemaType="case-study"
  footerVariant="photoOnly"
>
  <section class="wrap">
    <div class="grid">
      <div class="inner-projects-hero hero-grid projects-top-reset">
        <h1 class="txt-xl">The R&B Awards</h1>
        <h2 class="subtxt">Identity & website</h2>
          <ul class="labels">
            <li class="labels subtxtgray">Logo design</li>
            <li class="labels subtxtgray">Identity</li>
            <li class="labels subtxtgray">Key visual</li>            
            <li class="labels subtxtgray">Web design</li>
            <li class="labels subtxtgray">Development</li>
            <li class="labels subtxtgray">Webflow</li>
          </ul>
        <!-- <p class="labels subtxtgray">Logo Design / Identity / Web Design / Development / Webflow</p> -->
      </div>
    </div>
  </section>
  <section class="wrap">
    <div class="grid inner-projects-hero marging-reset">
      <div class="projects-grid">
        <div class="grid-1">
          <div>   
            <figure>
              <video 
                width="1920" 
                height="1080" 
                preload="auto" 
                autoplay 
                loop 
                muted 
                playsinline 
                poster="/images/work/the-rnb-awards/the-rnb-awards_logo-wide.avif" 
                class="project-video img-responsive">
                <source src="/images/work/the-rnb-awards/the-rnb-awards_logo-keyvisial-animation.mp4" type="video/mp4">
                Your browser does not support the video tag.
              </video>
              <figcaption class="visually-hidden">
                A looping animation of The R&B Awards logo and key visual system in motion.
              </figcaption>
            </figure>
          </div>
          <div>
            <figure>
              <img class="img-responsive"src="/images/work/the-rnb-awards/the-rnb-awards_stage_photograph.avif" alt="The R&B Awards ceremony stage with logo and key visual on the video wall backdrop — by Lyudmil Dachev."
              loading="lazy" width="2480" height="1395">
              <figcaption class="visually-hidden">The R&B Awards ceremony stage with the logo and key visual displayed on the video wall backdrop.</figcaption>
            </figure>
          </div>
          <div class="grid-2">
            <figure>
              <img class="img-responsive"src="/images/work/the-rnb-awards/the-rnb-awards_perfomance_onstage.avif" alt="Live band performance at The R&B Awards ceremony with key visual system in motion on stage backdrop — by Lyudmil Dachev."
              loading="lazy" width="1230" height="848">
              <figcaption class="visually-hidden">The identity in use — key visual system in motion behind a live performance at The R&B Awards ceremony.</figcaption>
            </figure>
            <figure>
            <img class="img-responsive"src="/images/work/the-rnb-awards/the-rnb-awards_statuettes.avif"alt="Custom statuettes designed for The R&B Awards ceremony by Lyudmil Dachev."
              loading="lazy" width="1230" height="848">
              <figcaption class="visually-hidden">Custom designed statuettes for The R&B Awards ceremony.</figcaption>
            </figure>
          </div>
          <div>
            <figure>
              <video 
                width="1920" 
                height="1080" 
                preload="auto" 
                autoplay 
                loop 
                muted 
                playsinline 
                poster="/images/work/the-rnb-awards/the-rnb-awards_logo-wide.avif" 
                class="project-video img-responsive">
                <source src="/images/work/the-rnb-awards/the-rnb-awards_social.mp4" type="video/mp4">
                Your browser does not support the video tag.
              </video>
              <figcaption class="visually-hidden">
                A showcase of motion and animation work created for The R&B Awards — identity in motion across digital applications.
              </figcaption>
            </figure>
          </div> 
          <div>
            <figure>
              <video 
                width="1920" 
                height="1080" 
                preload="auto" 
                autoplay 
                loop 
                muted 
                playsinline 
                poster="/images/work/the-rnb-awards/the-rnb-awards_logo-wide.avif" 
                class="project-video img-responsive">
                <source src="/images/work/the-rnb-awards/the-rnb-awards_website.mp4" type="video/mp4">
                Your browser does not support the video tag.
              </video>
              <figcaption class="visually-hidden">
               The R&B Awards website homepage — designed and developed by Lyudmil Dachev.
              </figcaption>
            </figure>
          </div>                                             
          <div>
            <figure>
              <video 
                width="1920" 
                height="1080" 
                preload="auto" 
                autoplay 
                loop 
                muted 
                playsinline 
                poster="/images/work/the-rnb-awards/the-rnb-awards_logo-wide.avif" 
                class="project-video img-responsive">
                <source src="/images/work/the-rnb-awards/the-rnb-awards_aftermovie.mp4" type="video/mp4">
                Your browser does not support the video tag.
              </video>
              <figcaption class="visually-hidden">
                The R&B Awards aftermovie — the identity system deployed across the full ceremony environment.
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </div>
  </section>
  
<!-- up next -->
  <section class="wrap">
    <a href="/work/brand-springboard/" class="upnext-link">
    <div class="grid">
      <div class="inner-projects-hero hero-grid projects-top-reset">
        <h3 class="subtxt subtxtgray">up next</h3>
        <h4 class="txt-xl">Brand Springboard</h4>
        <h5 class="subtxt">Identity & website</h5>
          <ul class="labels">
            <li class="labels subtxtgray">Logo design</li>
            <li class="labels subtxtgray">Identity</li>
            <li class="labels subtxtgray">Web design</li>
            <li class="labels subtxtgray">Development</li>
            <li class="labels subtxtgray">Webflow</li>
          </ul>

      </div>
    </div>

    <div class="grid inner-projects-hero marging-reset">
      <div class="projects-grid" style="padding-bottom: 0;">
        <div class="grid-1">

          <div>
            <figure class="upnext-img">
            <lottie-player class="img-responsive"
              src="/images/work/brand-springboard/brand-springboard_logo-animation.json" 
              background="transparent" 
              speed="1" 
              loop 
              autoplay 
              role="img" 
              width="3840" 
              height="2160" 
              aria-label="Animated Brand Springboard logo by Lyudmil Dachev">
            </lottie-player>
            <figcaption class="visually-hidden">A smooth loop animation of the Brand Springboard logo.</figcaption>
            </figure>
          </div>                                         

        </div>
      </div>
    </div>
    </a>
  </section>
<!-- end of upnext -->

<Cta />
</BaseLayout>