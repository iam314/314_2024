---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';

const meta = {
  title: "The horizon – Limited Edition Screen Print by Lyudmil Dachev",
  description: "The horizon is a limited edition hand-pulled screen print by Lyudmil Dachev. Edition of 5, signed and numbered, 25×17.5 cm. Ships worldwide.",
  link: "https://www.iam314.com/store/horizon-print/",
  ogImage: "/images/ogimages/og-the-horizon.png",
  price: "9",
  availability: "https://schema.org/InStock",
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  link={meta.link}
  ogImage={meta.ogImage}
  schemaType="product"
  price={meta.price}
  availability={meta.availability}
  useSwiper
  footerVariant="inner"
>
    <section class="wrap inner-store-hero">
      <div class="grid">
        <div class="productgallery-grid">
          <div class="product-gallery">
            <!-- Thumbnail slider -->
            <div class="swiper product-thumbs">
              <div class="swiper-wrapper">
                <div class="swiper-slide">
                  <img src="/images/store/thehorizon/thehorizon_1.avif" alt="The horizon screen print — full view" loading="lazy">
                </div>
                <div class="swiper-slide">
                  <img src="/images/store/thehorizon/thehorizon_2.avif" alt="The horizon screen print — details view" loading="lazy">
                </div>
              </div>
            </div>
            <!-- Main slider -->
            <div class="swiper product-main">
              <div class="swiper-wrapper">
                <div class="swiper-slide">
                  <img src="/images/store/thehorizon/thehorizon_1.avif" alt="The horizon screen print — full view" loading="lazy">
                </div>
                <div class="swiper-slide">
                  <img src="/images/store/thehorizon/thehorizon_2.avif" alt="The horizon screen print — details view" loading="lazy">
                </div>
              </div>
            </div>
          </div>
        </div>      
        <div class="productdecription-grid">
          <h1 class="txt-l">The horizon</h1>
          <p class="txt-s">€9</p>
          <p class="subtxtgray">Hand pulled screen print</p>
          <p class="paragraph1">This print is original artwork, hand-printed and hand-cuted by Lyudmil Dachev. Limited edition run of 5 posters. All signed and numbered.<br>
          Dimensions: 25x17.5 centimeters / 9.842x6.889 inch</p>
          <div class="buttons">
            <a href="https://payhip.com/b/EoFTW?redirect=https://iam314.com/thank-you.html"
              class="add-btn payhip-add-to-cart-button"
              data-theme="none"
              data-product="EoFTW">
              Add to cart
            </a>
            <button type="button"
              class="buy-btn buy-now-btn"
              data-product="EoFTW"
              data-message="Thanks for buying The horizon print!"
              data-title="The horizon – limited edition print"
            >Buy
            </button>
          </div>
        </div>
      </div>
    </section>
<Faq />

<!-- STORE -->
  <script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".buy-now-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        Payhip.Checkout.open({
          product: btn.dataset.product,
          method: "overlay",
          message: btn.dataset.message,
          title: btn.dataset.title,
          successUrl: "https://iam314.com/thanks/"
        });
      });
    });
  });
  </script>

<!-- SWIPER -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    // Thumbnails
const thumbsSwiper = new Swiper('.product-thumbs', {
  spaceBetween: 8,
  freeMode: true,
  watchSlidesProgress: true,

  // default (desktop)
  direction: 'vertical',
  slidesPerView: 'auto',

  breakpoints: {
    0: {
      direction: 'horizontal',
      slidesPerView: 'auto'
    },
    767: {
      direction: 'vertical',
      slidesPerView: 'auto'
    }
  }
});

    // Main slider with thumbs
    const mainSwiper = new Swiper('.product-main', {
      spaceBetween: 16,
      loop: true,
      grabCursor: true,
      thumbs: {
        swiper: thumbsSwiper
      }
    });
  });
</script>
</BaseLayout>
