---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cta from '../../components/CTA.astro';

const meta = {
  title: "Outsider Talks — Brand Identity by Lyudmil Dachev",
  description: "Brand identity for Outsider Talks, a podcast about alternative lifestyles and unconventional paths. Logo and visual identity by Lyudmil Dachev.",
  link: "https://www.iam314.com/work/outsider-talks/",
  ogImage: "/images/ogimages/og-outsider-talks.png",
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  link={meta.link}
  ogImage={meta.ogImage}
  schemaType="case-study"
  footerVariant="photoOnly"
>
  <section class="wrap">
    <div class="grid">
      <div class="inner-projects-hero hero-grid projects-top-reset">
        <h1 class="txt-xl">Outsider Talks</h1>
        <h2 style="margin-bottom: 0;" class="subtxt">Identity</h2>
          <ul class="labels">
            <li class="labels subtxtgray">Logo design</li>
            <li class="labels subtxtgray">Identity</li>
          </ul>
      </div>
    </div>
  </section>

<section class="wrap">
  <div class="grid inner-projects-hero marging-reset">
    <div class="projects-grid">
      <div class="grid-1">
        
        <figure>
          <lottie-player 
            src="/images/work/outsider-talks/outsider-talks_logo-animation.json" 
            background="transparent" 
            speed="1" 
            loop 
            autoplay
            muted 
            role="img" 
            width="1920" 
            height="1200" 
            aria-label="Animated Outsider Talks logo by Lyudmil Dachev">
          </lottie-player>
          <figcaption class="visually-hidden">
            Animated logo for Outsider Talks, a podcast exploring unconventional life paths.
          </figcaption>
        </figure>

        <div class="grid-2">
          <figure>
            <img class="img-responsive" src="/images/work/outsider-talks/outsider-talks_icon.avif" 
                 alt="Outsider Talks brand icon design by Lyudmil Dachev" 
                 loading="lazy" width="1270" height="794">
            <figcaption class="visually-hidden">
              The primary Outsider Talks brand icon designed for social media and small-scale use.
            </figcaption>
          </figure>
          <figure>
            <img class="img-responsive" src="/images/work/outsider-talks/outsider-talks_logo_light_background.avif" 
                 alt="Outsider Talks primary logo on light background" 
                 loading="lazy" width="2560" height="1440">
            <figcaption class="visually-hidden">
              Outsider Talks primary typographic wordmark displayed on a clean, light background.
            </figcaption>
          </figure>
        </div>

        <div class="grid-4">
          <figure>
            <img class="img-responsive" src="/images/work/outsider-talks/outsider-talks_logo_staked-orange.avif" 
                 alt="Outsider Talks stacked logo in brand orange" 
                 loading="lazy" width="628" height="628">
            <figcaption class="visually-hidden">Stacked logo variation in brand-specific orange.</figcaption>
          </figure>
          <figure>
            <img class="img-responsive" src="/images/work/outsider-talks/outsider-talks_logo_staked-3-light.avif" 
                 alt="Outsider Talks multi-level stacked logo variation" 
                 loading="lazy" width="628" height="628">
            <figcaption class="visually-hidden">A multi-level stacked typographic lockup for the Outsider Talks identity.</figcaption>
          </figure>
          <figure>
            <img class="img-responsive" src="/images/work/outsider-talks/outsider-talks_logo_staked-2-light.avif" 
                 alt="Outsider Talks minimalist stacked logo variation" 
                 loading="lazy" width="628" height="628">
            <figcaption class="visually-hidden">A simplified, two-tier stacked logo lockup.</figcaption>
          </figure>
          <figure>
            <img class="img-responsive" src="/images/work/outsider-talks/outsider-talks_logo_staked-3-orange.avif" 
                 alt="Outsider Talks three-tier stacked logo in orange" 
                 loading="lazy" width="628" height="628">
            <figcaption class="visually-hidden">Vertical brand lockup variation in high-contrast orange.</figcaption>
          </figure>
        </div>

        <figure>
          <img class="img-responsive" src="/images/work/outsider-talks/outsider-talks_ontheweb.avif" 
               alt="Outsider Talks identity applied to digital and web platforms" 
               loading="lazy" width="2560" height="1440">
          <figcaption class="visually-hidden">
            A showcase of the Outsider Talks visual identity system in a digital environment.
          </figcaption>
        </figure>

      </div>
    </div>
  </div>
</section> 

<!-- up next -->
  <section class="wrap">
    <a href="/work/terrasse/" class="upnext-link">
    <div class="grid">
      <div class="inner-projects-hero hero-grid projects-top-reset">
        <h3 class="subtxt subtxtgray">up next</h3>
        <h4 class="txt-xl">Terrasse</h4>
        <h5 class="subtxt">Identity & Campaign</h5>
          <ul class="labels">
            <li class="labels subtxtgray">Logo design</li>
            <li class="labels subtxtgray">Identity</li>
            <li class="labels subtxtgray">Campaign</li>
            <li class="labels subtxtgray">Motion</li>
          </ul>
      </div>
    </div>

    <div class="grid inner-projects-hero marging-reset">
      <div class="projects-grid" style="padding-bottom: 0;">
        <div class="grid-1">

          <div>
            <figure class="upnext-img">
              <lottie-player class="img-responsive"
              src="/images/work/terrasse/terrasse_lottie_old.json" 
              background="#fafafa" 
              speed="1" 
              loop 
              autoplay 
              muted
              role="img"
              width="1920"
              height="1080"
              aria-label="Animated Terrasse logo by Lyudmil Dachev">
            </lottie-player>
            <figcaption class="visually-hidden">
              Motion design for the Terrasse identity, showcasing the fluid brand mark.
            </figcaption>
            </figure>
          </div>                                         

        </div>
      </div>
    </div>
    </a>
  </section>
<!-- end of upnext -->

<Cta />
</BaseLayout>