---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import type { ProductSchema } from '../data/productPages';
import { assetVersion } from '../utils/assetVersion';
// Self-hosted rather than pulled from jsdelivr: one less third-party origin, and
// it goes through the bundler so it is hashed and cached like everything else.
import 'lenis/dist/lenis.css';

// Versioned so a CSS/JS change is picked up immediately instead of being served
// from cache. See src/utils/assetVersion.ts.
const vNormalize = assetVersion('css/normalize.css');
const vLyudmils = assetVersion('css/lyudmils.css');
const vScripts = assetVersion('js/lyudmils.js');

interface Props {
  title: string;
  description: string;
  link: string;
  ogImage: string;
  schemaType?: 'base' | 'case-study' | 'product';
  price?: string;
  availability?: string;
  product?: ProductSchema;
  footerVariant?: 'home' | 'inner' | 'photoOnly';
}

const {
  title,
  description,
  link,
  ogImage,
  schemaType = 'base',
  price,
  availability,
  product,
  footerVariant = 'home',
} = Astro.props;
---

<!DOCTYPE html>
<!-- Designed and developed by Lyudmil Dachev -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{title}</title>
  <link rel="canonical" href={link} />
  <meta name="description" content={description} />
  <meta name="author" content="Lyudmil Dachev">
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={'https://www.iam314.com' + ogImage} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={'https://www.iam314.com' + ogImage} />
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {/*
    Third-party origins. All three are requested on every page: jsdelivr serves
    Lenis (and Swiper on store pages), Google serves gtag, Payhip serves the cart.
    Preconnecting overlaps their DNS + TCP + TLS with our own loading.

    No `crossorigin` here, because these are loaded as plain stylesheets and
    scripts. A crossorigin preconnect would open a separate connection that the
    non-CORS requests would never reuse.
  */}
  <link rel="preconnect" href="https://www.googletagmanager.com">
  <link rel="preconnect" href="https://payhip.com">

  {/*
    The body font is render-critical but is only discovered once lyudmils.css has
    downloaded and been parsed, so without this the font sits at the end of a
    waterfall. Preloading starts it alongside the stylesheets.

    `crossorigin` is required even though the font is same-origin: font fetches
    are always CORS-mode, and a preload that does not match is discarded and the
    font is downloaded twice. For the same reason the href must match the
    @font-face URL exactly — hence no ?v= here, since the CSS requests the bare path.
  */}
  <link rel="preload" href="/fonts/ABCArealVariable.woff2" as="font" type="font/woff2" crossorigin>

  <link href={`/css/normalize.css?v=${vNormalize}`} rel="stylesheet" type="text/css">
  <link href={`/css/lyudmils.css?v=${vLyudmils}`} rel="stylesheet" type="text/css">
  {/* nandr.css is only used by /niceandrandom/ and is loaded there. */}
  <slot name="head" />
  <link href="/images/favicon.png" rel="shortcut icon" type="image/x-icon">
  <link href="/images/webclip.png" rel="apple-touch-icon">

  {/*
    Lenis smooth scroll. The stylesheet is imported in the frontmatter above;
    this rule is the one thing lenis.css does not ship, and without it the
    native smooth-scroll fights Lenis for control of the page.
  */}
  <style is:inline>
    .lenis.lenis-smooth { scroll-behavior: auto !important; }
  </style>
  <script>
    import Lenis from 'lenis';

    // Module scripts run after the document is parsed, so there is no need to
    // wait for DOMContentLoaded or check that Lenis loaded. The previous version
    // loaded from a CDN and bailed out if window.Lenis was not there yet.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const lenis = new Lenis({
        autoRaf: true, // built-in requestAnimationFrame loop
        anchors: true, // smooth-scroll same-page anchor links
      });

      (window as any).lenis = lenis; // handy for poking at it from the console
    }
  </script>
  <JsonLd {title} {description} {link} {ogImage} schemaType={schemaType} price={price} availability={availability} product={product} />
  <script is:inline src={`/js/lyudmils.js?v=${vScripts}`} defer></script>

  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8K5NWXN6WD"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-8K5NWXN6WD');
  </script>

</head>
<body class="body-light">
  <Nav />
  <main>
    <slot />
  </main>
  <Footer variant={footerVariant} />

  {/*
    STORE / Payhip

    Payhip renders the cart in a cross-origin iframe on payhip.com and keeps no
    state we can read — no localStorage, no sessionStorage, no cookie on our own
    origin. So there is no way to ask "does the cart have anything in it?" without
    loading Payhip, which is the cost we are trying to avoid.

    Instead we keep our own flag, set when a cart control is used, and load Payhip
    when that flag is set (so the cart bubble appears for a returning shopper) or
    when the page carries add-to-cart controls. The control check reads the DOM, so
    a new product page needs no extra wiring here and cannot silently lose add-to-cart.

    Sitting at the end of <body> means the page content is already parsed, so
    payhip.js starts downloading without waiting for DOMContentLoaded.
  */}
  <script is:inline>
    var PayhipConfig = { enableCart: true };
  </script>
  <script is:inline>
    (function () {
      var CART_FLAG = 'iam314:cart-active';
      var CONTROLS = '.payhip-add-to-cart-button, .buy-now-btn';

      function loadPayhip() {
        if (window.__payhipRequested) return;
        window.__payhipRequested = true;
        var s = document.createElement('script');
        s.src = 'https://payhip.com/payhip.js';
        s.defer = true;
        document.head.appendChild(s);
      }

      // Remember that this visitor has used the cart, so later pages show the bubble.
      // Capture phase, so this still records the click even if Payhip's own handler
      // stops propagation.
      document.addEventListener(
        'click',
        function (e) {
          var t = e.target;
          if (t && t.closest && t.closest(CONTROLS)) {
            try { localStorage.setItem(CART_FLAG, '1'); } catch (err) {}
          }
        },
        true,
      );

      var usedCart = false;
      try { usedCart = localStorage.getItem(CART_FLAG) === '1'; } catch (err) {}

      if (usedCart || document.querySelector(CONTROLS)) loadPayhip();
    })();
  </script>
</body>
</html>
