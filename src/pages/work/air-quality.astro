---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cta from '../../components/CTA.astro';

const meta = {
  title: "Air Quality App — Mobile App Design by Lyudmil Dachev",
  description: "UX/UI and mobile app design for an air quality monitoring application for Melon. Real-time data visualisation and dark mode by Lyudmil Dachev.",
  link: "https://www.iam314.com/work/air-quality/",
  ogImage: "/images/ogimages/og-air-quality-app.png",
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  link={meta.link}
  ogImage={meta.ogImage}
  schemaType="case-study"
  footerVariant="photoOnly"
>
  <section class="wrap">
    <div class="grid">
      <div class="inner-projects-hero hero-grid projects-top-reset">
        <h1 class="txt-xl">Air Quality App</h1>
        <h2 style="margin-bottom: 0;" class="subtxt">Mobile App Design</h2>
          <ul class="labels">
            <li class="labels subtxtgray">UX/UI</li>
            <li class="labels subtxtgray">Mobile design</li>
            <li class="labels subtxtgray">Data visualization</li>
          </ul>
      </div>
    </div>
  </section>
  <section class="wrap">
    <div class="grid inner-projects-hero marging-reset">
      <div class="projects-grid">
        <div class="grid-1">
          
          <figure>
            <img class="img-responsive" src="/images/work/air-quality/air-quality-app-main-screens.avif" 
                 alt="Main interface screens for the Air Quality monitoring app by Lyudmil Dachev" 
                 loading="lazy" width="2560" height="2404">
            <figcaption class="visually-hidden">
              Overview of the primary mobile interface screens for the Air Quality monitoring application.
            </figcaption>
          </figure>

          <figure>
            <img class="img-responsive" src="/images/work/air-quality/air-quality-dataandvisuals.avif" 
                 alt="Data visualization and UI elements for Air Quality app" 
                 loading="lazy" width="2560" height="1345">
            <figcaption class="visually-hidden">
              Detailed view of the data visualization components.
            </figcaption>
          </figure>

          <figure>
            <img class="img-responsive" src="/images/work/air-quality/airquality-dataandvisuals.gif" 
                 alt="Animated composition of data visualization components." 
                 loading="lazy" width="1920" height="1440">
            <figcaption class="visually-hidden">
              Variants of the data visualization components in a nice mandala composition.
            </figcaption>
          </figure>

          <figure>
            <img class="img-responsive" src="/images/work/air-quality/darkmore-activation.gif" 
                 alt="Interface transition between light and dark mode" 
                 loading="lazy" width="2560" height="1216">
            <figcaption class="visually-hidden">
              Demonstration of the seamless transition into the app's optimized dark mode.
            </figcaption>
          </figure>

          <figure>
            <img class="img-responsive" src="/images/work/air-quality/airquality-darkmode-screens.gif" 
                 alt="Showcase of full Air Quality app interface in dark mode" 
                 loading="lazy" width="2560" height="1360">
            <figcaption class="visually-hidden">
              Comprehensive look at the mobile application's dark mode visual system.
            </figcaption>
          </figure>

          <figure>
            <img class="img-responsive" src="/images/work/air-quality/airqulity-all-screens.avif" 
                 alt="Full design system and mobile screen overview for Air Quality app" 
                 loading="lazy" width="2560" height="1562">
            <figcaption class="visually-hidden">
              The complete set of mobile screens demonstrating the unified design system for the monitoring platform.
            </figcaption>
          </figure>

        </div>
      </div>
    </div>
  </section> 

<!-- up next -->
  <section class="wrap">
    <a href="/work/ora-estete/" class="upnext-link">
    <div class="grid">
      <div class="inner-projects-hero hero-grid projects-top-reset">
        <h3 class="subtxt subtxtgray">up next</h3>
        <h4 class="txt-xl">Ora Estete</h4>
        <h5 class="subtxt">Logo & Website</h5>
          <ul class="labels">
            <li class="labels subtxtgray">Logo design</li>
            <li class="labels subtxtgray">Web design</li>
            <li class="labels subtxtgray">Development</li>
            <li class="labels subtxtgray">Webflow</li>
          </ul>
      </div>
    </div>

    <div class="grid inner-projects-hero marging-reset">
      <div class="projects-grid" style="padding-bottom: 0;">
        <div class="grid-1">

          <div>
            <figure class="upnext-img">
            <lottie-player 
              src="/images/work/ora-estete/ora-estete_logo-animation.json" 
              background="#fbfbfb" 
              speed="1" 
              loop 
              autoplay 
              muted
              role="img"
              width="1920"
              height="1080"
              aria-label="Animated Ora Estete logo by Lyudmil Dachev">
            </lottie-player>
            <figcaption class="visually-hidden">
              Motion design for the Ora Estete identity, showcasing the fluid brand mark for the video production studio.
            </figcaption>
            </figure>
          </div>                                         

        </div>
      </div>
    </div>
    </a>
  </section>
<!-- end of upnext -->

<Cta />
</BaseLayout>