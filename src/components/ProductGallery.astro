---
import type { GalleryItem } from '../data/productPages';
// Self-hosted Swiper. Core CSS only: the site styles the gallery itself, and the
// module styles in swiper-bundle.css (navigation, pagination, scrollbar, effects,
// zoom, lazy) were for options this gallery does not enable.
import 'swiper/css';

interface Props {
  items: GalleryItem[];
  /** Accessible name for the gallery, e.g. "The Kiss screen print gallery". */
  label: string;
}

const { items, label } = Astro.props;

const thumbSrc = (item: GalleryItem) => item.thumbSrc ?? item.src;
const thumbWidth = (item: GalleryItem) => item.thumbWidth ?? item.width;
const thumbHeight = (item: GalleryItem) => item.thumbHeight ?? item.height;
---

<div class="product-gallery" role="group" aria-label={label}>
  <!--
    Thumbnail slider. These are decorative duplicates of the main slides, so the
    images carry an empty alt rather than repeating the description twice.
  -->
  <div class="swiper product-thumbs">
    <div class="swiper-wrapper">
      {
        items.map((item) => (
          <div class="swiper-slide">
            <img
              src={thumbSrc(item)}
              alt=""
              width={thumbWidth(item)}
              height={thumbHeight(item)}
              loading="lazy"
              decoding="async"
            />
          </div>
        ))
      }
    </div>
  </div>

  <!-- Main slider. The first slide is the LCP element, so it loads eagerly. -->
  <div class="swiper product-main">
    <div class="swiper-wrapper">
      {
        items.map((item, i) =>
          item.type === 'video' ? (
            <div class="swiper-slide">
              <video
                width={item.width}
                height={item.height}
                preload="metadata"
                loop
                muted
                playsinline
                controls
                poster={item.poster}
                aria-label={item.alt}
              >
                <source src={item.src} type="video/mp4" />
                Your browser does not support the video tag.
              </video>
            </div>
          ) : (
            <div class="swiper-slide">
              <img
                src={item.src}
                alt={item.alt}
                width={item.width}
                height={item.height}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                decoding={i === 0 ? undefined : 'async'}
              />
            </div>
          )
        )
      }
    </div>
  </div>
</div>

<script>
  import Swiper from 'swiper';
  import { Thumbs, FreeMode } from 'swiper/modules';

  /**
   * Only the slide in view should play, so a video does not buffer until it is seen.
   * This used to live inline on the Stray page only; it is harmless on galleries
   * with no video, where no slide contains one.
   */
  const syncProductVideos = (swiper: Swiper) => {
    const active = swiper.slides[swiper.activeIndex];
    swiper.slides.forEach((slide) => {
      const video = slide.querySelector('video');
      if (!video) return;
      if (slide === active) {
        // play() rejects when the browser blocks autoplay — ignore that.
        const started = video.play();
        if (started && started.catch) started.catch(() => {});
      } else if (!video.paused) {
        video.pause();
      }
    });
  };

  let thumbsSwiper: Swiper | undefined;
  let mainSwiper: Swiper | undefined;

  /**
   * (Re)build the gallery. This runs on `astro:page-load` because the script
   * itself only executes once: on subsequent client-side navigations Astro skips
   * identical scripts, so the listener registered here is what keeps later
   * product pages working.
   */
  const initGallery = () => {
    if (!document.querySelector('.product-thumbs') || !document.querySelector('.product-main')) return;

    // Drop the previous page's instances before building the new ones.
    mainSwiper?.destroy(true, true);
    thumbsSwiper?.destroy(true, true);

    thumbsSwiper = new Swiper('.product-thumbs', {
      modules: [FreeMode],
      spaceBetween: 8,
      freeMode: true,
      watchSlidesProgress: true,

      // default (desktop)
      direction: 'vertical',
      slidesPerView: 'auto',

      breakpoints: {
        0: {
          direction: 'horizontal',
          slidesPerView: 'auto',
        },
        767: {
          direction: 'vertical',
          slidesPerView: 'auto',
        },
      },
    });

    mainSwiper = new Swiper('.product-main', {
      modules: [Thumbs],
      spaceBetween: 16,
      loop: true,
      grabCursor: true,
      thumbs: {
        swiper: thumbsSwiper,
      },
      on: {
        init: syncProductVideos,
        activeIndexChange: syncProductVideos,
      },
    });
  };

  document.addEventListener('astro:page-load', initGallery);

  // Fallback for a hard load with no View Transitions router (or JS disabled
  // scripts): initialise as soon as the DOM is ready.
  if (!document.querySelector('meta[name="astro-view-transitions-enabled"]')) {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGallery, { once: true });
    } else {
      initGallery();
    }
  }
</script>
