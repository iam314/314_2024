---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import { getProductPage } from '../../data/productPages';

const meta = {
  title: "Flag Icons – 112 Minimal Flag Icons & Lottie Animations by Lyudmil Dachev",
  description: "Flag Icons is a collection of 112 flag icons by Lyudmil Dachev, plus 15 animated flags in Lottie, JSON, GIF and EPS. Personal & commercial use allowed.",
  link: "https://www.iam314.com/store/flag-icons/",
  ogImage: "/images/ogimages/og-flag-icons.png",
  price: "0",
  availability: "https://schema.org/InStock",
};

const { gallery, schema } = getProductPage('flag-icons');
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  link={meta.link}
  ogImage={meta.ogImage}
  schemaType="product"
  price={meta.price}
  availability={meta.availability}
  product={schema}
  footerVariant="inner"
>
    <section class="wrap inner-store-hero">
      <div class="grid">
        <div class="productgallery-grid">
          <ProductGallery items={gallery} label="Flag Icons icon set gallery" />
        </div>      
        <div class="productdecription-grid">
          <h1 class="txt-l">Flag icons</h1>
          <p class="txt-s">€0+</p>
          <p class="subtxtgray">Flag icons and lottie animations</p>
          <p class="paragraph1">A collection of 112 minimal flag icons designed in a 4px grid. You get one .eps file with all flags plus 15 animated flags in Lottie (.lottie, .json) and .gif formats.</p>
          <h2 class="txt-s">Usage & Support</h2>
            <p class="paragraph1  paragraph1-s">
            Personal & commercial use allowed.<br>
            No repackaging or reselling allowed.<br>
            Want to buy me a coffee? I won’t say no!</p>
          <div class="buttons">
            <a href="https://payhip.com/b/Bm2yX?redirect=https://iam314.com/thanks/"
              class="add-btn payhip-add-to-cart-button"
              data-theme="none"
              data-product="Bm2yX">
              Add to cart
            </a>
            <button type="button"
              class="buy-btn buy-now-btn"
              data-product="Bm2yX"
              data-message="Thanks for buying the Flag Icons!"
              data-title="Flag icons & animations"
            >Buy
            </button>
          </div>
        </div>
      </div>
    </section>
<Faq />

<!-- STORE -->
  <script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".buy-now-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        Payhip.Checkout.open({
          product: btn.dataset.product,
          method: "overlay",
          message: btn.dataset.message,
          title: btn.dataset.title,
          successUrl: "https://iam314.com/thanks/"
        });
      });
    });
  });
  </script>
</BaseLayout>
