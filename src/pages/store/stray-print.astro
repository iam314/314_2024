---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import { getProductPage } from '../../data/productPages';

const meta = {
  title: "Stray – Limited Edition Giclée Print by Lyudmil Dachev",
  description: "Stray is an original fine art giclée print by Lyudmil Dachev, printed on Hahnemühle Photo Rag® paper and hand-signed. 30 × 40 cm. Ships worldwide.",
  link: "https://www.iam314.com/store/stray-print/",
  ogImage: "/images/ogimages/og-stray.png",
  price: "40",
  availability: "https://schema.org/InStock",
};

const { gallery, schema } = getProductPage('stray-print');
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  link={meta.link}
  ogImage={meta.ogImage}
  schemaType="product"
  price={meta.price}
  availability={meta.availability}
  product={schema}
  useSwiper
  footerVariant="inner"
>
    <section class="wrap inner-store-hero">
      <div class="grid">
        <div class="productgallery-grid">
          <ProductGallery items={gallery} label="Stray limited edition giclée print gallery" />
        </div>      
        <div class="productdecription-grid">
          <h1 class="txt-l">Stray</h1>
          <p class="txt-s">€40</p>
          <p class="subtxtgray">Limited edition giclée print</p>
          <p class="paragraph1">
            Original artwork by Lyudmil Dachev.<br>Printed as a fine art giclée on museum-quality Hahnemühle Photo Rag® Bright White paper.<br>Hand-signed by the artist in graphite.
          <br>
          Dimensions: 30x40 centimeters / 11.811x15.748 inch</p>
          <div class="buttons">
            <a href="https://payhip.com/b/NBivw?redirect=https://iam314.com/thank-you.html"
              class="add-btn payhip-add-to-cart-button"
              data-theme="none"
              data-product="NBivw">
              Add to cart
            </a>
            <button type="button"
              class="buy-btn buy-now-btn"
              data-product="NBivw"
              data-message="Thanks for buying Stray print!"
              data-title="Stray – limited edition print"
            >Buy
            </button>
          </div>
        </div>
      </div>
    </section>
<Faq />

<!-- STORE -->
  <script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".buy-now-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        Payhip.Checkout.open({
          product: btn.dataset.product,
          method: "overlay",
          message: btn.dataset.message,
          title: btn.dataset.title,
          successUrl: "https://iam314.com/thanks/"
        });
      });
    });
  });
  </script>

<!-- SWIPER -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    // Thumbnails
const thumbsSwiper = new Swiper('.product-thumbs', {
  spaceBetween: 8,
  freeMode: true,
  watchSlidesProgress: true,

  // default (desktop)
  direction: 'vertical',
  slidesPerView: 'auto',

  breakpoints: {
    0: {
      direction: 'horizontal',
      slidesPerView: 'auto'
    },
    767: {
      direction: 'vertical',
      slidesPerView: 'auto'
    }
  }
});

    // Only the slide in view should be playing, so the video only buffers when it is seen.
    const syncProductVideos = (swiper) => {
      const active = swiper.slides[swiper.activeIndex];
      swiper.slides.forEach(function (slide) {
        const video = slide.querySelector('video');
        if (!video) return;
        if (slide === active) {
          // play() rejects when the browser blocks autoplay - ignore that.
          const started = video.play();
          if (started && started.catch) started.catch(function () {});
        } else if (!video.paused) {
          video.pause();
        }
      });
    };

    // Main slider with thumbs
    const mainSwiper = new Swiper('.product-main', {
      spaceBetween: 16,
      loop: true,
      grabCursor: true,
      thumbs: {
        swiper: thumbsSwiper
      },
      on: {
        init: syncProductVideos,
        activeIndexChange: syncProductVideos
      }
    });
  });
</script>
</BaseLayout>
