---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cta from '../../components/CTA.astro';

const meta = {
  title: "Terrasse — Brand Identity & Campaign by Lyudmil Dachev",
  description: "Brand identity and social media campaign for Terrasse by Raffy, a club in downtown Sofia. Logo, visual identity, and graphics by Lyudmil Dachev.",
  link: "https://www.iam314.com/work/terrasse/",
  ogImage: "/images/ogimages/og-terrasse.png",
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  link={meta.link}
  ogImage={meta.ogImage}
  schemaType="case-study"
  footerVariant="photoOnly"
>
  <section class="wrap">
    <div class="grid">
      <div class="inner-projects-hero hero-grid projects-top-reset">
        <h1 class="txt-xl">Terrasse</h1>
        <h2 style="margin-bottom: 0;" class="subtxt">Identity & Campaign</h2>
          <ul class="labels">
            <li class="labels subtxtgray">Logo design</li>
            <li class="labels subtxtgray">Identity</li>
            <li class="labels subtxtgray">Campaign</li>
            <li class="labels subtxtgray">Motion</li>
          </ul>
      </div>
    </div>
  </section>
 <section class="wrap">
    <div class="grid inner-projects-hero marging-reset">
      <div class="projects-grid">
        <div class="grid-1">

          <figure>
            <lottie-player 
              src="/images/work/terrasse/terrasse_lottie_old.json" 
              background="#fafafa" 
              speed="1" 
              loop 
              autoplay 
              muted
              role="img"
              width="1920"
              height="1080"
              aria-label="Animated Terrasse logo by Lyudmil Dachev">
            </lottie-player>
            <figcaption class="visually-hidden">
              Motion design for the Terrasse identity, showcasing the fluid brand mark.
            </figcaption>
          </figure>

          <figure>
            <img class="img-responsive" src="/images/work/terrasse/terrasse_wordmark.avif" 
                 alt="Terrasse custom wordmark design by Lyudmil Dachev" 
                 loading="lazy" width="2546" height="907">
            <figcaption class="visually-hidden">
              The custom typographic wordmark for Terrasse, reflecting a modern hospitality aesthetic.
            </figcaption>
          </figure>

          <div class="grid-2">
            <figure>
              <img class="img-responsive" src="/images/work/terrasse/terrasse_icon_light.avif" 
                   alt="Terrasse brand icon on light background" 
                   loading="lazy" width="1270" height="794">
              <figcaption class="visually-hidden">Terrasse brand icon variation optimized for light backgrounds.</figcaption>
            </figure>
            <figure>
              <img class="img-responsive" src="/images/work/terrasse/terrasse_icon_dark.avif" 
                   alt="Terrasse brand icon on dark background" 
                   loading="lazy" width="1270" height="794">
              <figcaption class="visually-hidden">Terrasse brand icon variation optimized for dark backgrounds.</figcaption>
            </figure>
          </div>

          <figure>
            <img class="img-responsive" src="/images/work/terrasse/terrasse_logo.avif" 
                 alt="Terrasse primary logo lockup" 
                 loading="lazy" width="2560" height="1440">
            <figcaption class="visually-hidden">The full logo lockup for Terrasse by Raffy.</figcaption>
          </figure>

          <figure>
            <img class="img-responsive" src="/images/work/terrasse/terrasse_events_program.avif" 
                 alt="Terrasse events program design" 
                 loading="lazy" width="2560" height="1397">
            <figcaption class="visually-hidden">Design system for Terrasse event programming and scheduling.</figcaption>
          </figure>
          
          <figure>
            <img class="img-responsive" src="/images/work/terrasse/terrasse_events_weekly.avif" 
                 alt="Terrasse weekly events campaign graphics" 
                 loading="lazy" width="2560" height="3356">
            <figcaption class="visually-hidden">Weekly event social media graphics for the Terrasse campaign.</figcaption>
          </figure>

          <figure>
            <img class="img-responsive" src="/images/work/terrasse/terrasse_events_specialevents.avif" 
                 alt="Terrasse special events identity" 
                 loading="lazy" width="2560" height="3328">
            <figcaption class="visually-hidden">Branding for special events and exclusive club nights at Terrasse.</figcaption>
          </figure>

          <figure>
            <video 
              width="1920" 
              height="1080" 
              preload="auto" 
              autoplay 
              loop 
              muted 
              playsinline 
              poster="/images/work/terrasse/terrasse_logo.avif" 
              class="project-video img-responsive">
              <source src="/images/work/terrasse/terrasse_events(1080p).mp4" type="video/mp4">
              Your browser does not support the video tag.
            </video>
            <figcaption class="visually-hidden">
              A video showcase of the motion graphics and social media campaign for Terrasse events.
            </figcaption>
          </figure>

        </div>
      </div>
    </div>
  </section> 

<!-- up next -->
  <section class="wrap">
    <a href="/work/bbc-maestro/" class="upnext-link">
    <div class="grid">
      <div class="inner-projects-hero hero-grid projects-top-reset">
        <h3 class="subtxt subtxtgray">up next</h3>
        <h4 class="txt-xl">BBC Maestro</h4>
        <h5 class="subtxt">Web App Design</h5>
          <ul class="labels">
            <li class="labels subtxtgray">UX/UI</li>
            <li class="labels subtxtgray">Web app design</li>
            <li class="labels subtxtgray">Art direction</li>
          </ul>
      </div>
    </div>

    <div class="grid inner-projects-hero marging-reset">
      <div class="projects-grid" style="padding-bottom: 0;">
        <div class="grid-1">

          <div>
            <figure class="upnext-img">
            <img class="img-responsive" src="/images/work/bbc-maestro/bbc-maestrologin_animation.gif" 
                 alt="BBC Maestro web app login screen motion study by Lyudmil Dachev" 
                 loading="lazy" width="2560" height="1204">
            <figcaption class="visually-hidden">
              A motion study of the login interface for the BBC Maestro performance scoring application.
            </figcaption>
            </figure>
          </div>                                         

        </div>
      </div>
    </div>
    </a>
  </section>
<!-- end of upnext -->

<Cta />
</BaseLayout>