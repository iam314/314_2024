---
import type { ProductSchema } from '../data/productPages';

interface Props {
  title: string;
  description: string;
  link: string;
  ogImage: string;
  schemaType?: 'base' | 'case-study' | 'product';
  price?: string;
  availability?: string;
  product?: ProductSchema;
}

const {
  title,
  description,
  link,
  ogImage,
  schemaType = 'base',
  price,
  availability,
  product,
} = Astro.props;

const SITE = 'https://www.iam314.com';
const abs = (path: string) => (path.startsWith('http') ? path : SITE + path);

// The returns policy published on every store page (see components/Faq.astro):
// 30 days, by mail, return shipping paid by the customer, digital goods excluded.
// NOTE: `applicableCountry` is intentionally omitted — the published policy has no
// geographic restriction. Add it (e.g. applicableCountry: ['BG', 'DE']) to switch on
// Google's return-policy badge for the countries you actually accept returns from.
const physicalReturnPolicy = {
  '@type': 'MerchantReturnPolicy',
  returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
  merchantReturnDays: 30,
  returnMethod: 'https://schema.org/ReturnByMail',
  returnFees: 'https://schema.org/ReturnShippingFees',
};

const digitalReturnPolicy = {
  '@type': 'MerchantReturnPolicy',
  returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
};

const baseGraph = [
  {
    '@type': 'Person',
    '@id': 'https://www.iam314.com/#person',
    name: 'Lyudmil Dachev',
    jobTitle: 'Brand Identity Designer & Webflow Developer',
    description:
      'Brand identity designer, Webflow developer, and maker. Building visual systems for founder-led businesses and independent art prints and type under my own name.',
    url: 'https://www.iam314.com',
    image: 'https://www.iam314.com/images/lyudmil-dachev-brand-identity-designer.avif',
    address: { '@type': 'PostalAddress', addressLocality: 'Sofia', addressCountry: 'BG' },
    sameAs: ['https://www.linkedin.com/in/iam314/', 'https://www.behance.net/iam314'],
    worksFor: { '@id': 'https://www.iam314.com/#organization' },
  },
  {
    '@type': 'ProfessionalService',
    '@id': 'https://www.iam314.com/#organization',
    name: 'iam314',
    url: 'https://www.iam314.com',
    logo: 'https://www.iam314.com/images/favicon.png',
    founder: { '@id': 'https://www.iam314.com/#person' },
    priceRange: '€€€',
    areaServed: 'Worldwide',
  },
  {
    '@type': 'WebSite',
    '@id': 'https://www.iam314.com/#website',
    url: 'https://www.iam314.com',
    name: 'iam314',
    publisher: { '@id': 'https://www.iam314.com/#organization' },
  },
  {
    '@type': 'WebPage',
    '@id': link,
    url: link,
    name: title,
    isPartOf: { '@id': 'https://www.iam314.com/#website' },
    about: { '@id': 'https://www.iam314.com/#person' },
    description,
  },
];

const graph = [...baseGraph];

if (schemaType === 'case-study') {
  graph.push({
    '@type': 'CreativeWork',
    '@id': link + '#work',
    url: link,
    name: title,
    creator: { '@id': 'https://www.iam314.com/#person' },
    description,
    image: 'https://www.iam314.com' + ogImage,
  });
}

if (schemaType === 'product') {
  const isPhysical = product?.productType !== 'digital';

  graph.push({
    '@type': 'Product',
    '@id': link + '#product',
    name: title,
    // Full gallery as an image array (first entry = primary). Falls back to the
    // OG image for any product that has no gallery data yet.
    image: product?.images?.length ? product.images.map(abs) : [abs(ogImage)],
    description,
    brand: { '@id': 'https://www.iam314.com/#organization' },
    ...(product?.sku ? { sku: product.sku } : {}),
    ...(product?.category ? { category: product.category } : {}),
    ...(product?.material ? { material: product.material } : {}),
    ...(product?.size ? { size: product.size } : {}),
    ...(product?.additionalProperty?.length
      ? {
          additionalProperty: product.additionalProperty.map(({ name, value }) => ({
            '@type': 'PropertyValue',
            name,
            value,
          })),
        }
      : {}),
    offers: {
      '@type': 'Offer',
      url: link,
      price,
      priceCurrency: 'EUR',
      availability,
      seller: { '@id': 'https://www.iam314.com/#organization' },
      ...(product?.minPrice
        ? {
            priceSpecification: {
              '@type': 'PriceSpecification',
              minPrice: product.minPrice,
              priceCurrency: 'EUR',
            },
          }
        : {}),
      hasMerchantReturnPolicy: isPhysical ? physicalReturnPolicy : digitalReturnPolicy,
    },
  });
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<script type="application/ld+json" is:inline set:html={jsonLd} />
