---
import BaseLayout from '../layouts/BaseLayout.astro';

const meta = {
  title: 'Lyudmil Dachev – Brand Identity Designer & Web Developer',
  description:
    'Lyudmil Dachev is a brand identity designer and web developer building visual systems for founder-led businesses that need to look and feel like what they actually are.',
  link: 'https://www.iam314.com/',
  ogImage: '/images/ogimages/opengraph.png',
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  link={meta.link}
  ogImage={meta.ogImage}
  footerVariant="home"
>
  <section class="wrap hero">
    <div class="grid">
      <div class="hero_wrap hero-grid">
        <h1 class="txt-xl">Beauty and function,<br>crafted into <span class="visually-hidden">brand identity and digital product</span> design.</h1>
        <p class="subtxt">I build brand identity systems and websites for people who care about quality.</p>
        <p class="txt-l name">Lyudmil Dachev<br>– Designer</p>
      </div>
    </div>
  </section>
  <section class="wrap">
    <div class="work-wrap">
      <img
        src="/images/Lyudmil_Dachev-work.avif"
        loading="eager"
        fetchpriority="high"
        sizes="(max-width: 767px) 87vw, (max-width: 991px) 85vw, (max-width: 1279px) 87vw, 98vw"
        srcset="/images/Lyudmil_Dachev-work-p-500.avif 500w, /images/Lyudmil_Dachev-work-p-800.avif 800w, /images/Lyudmil_Dachev-work-p-1080.avif 1080w, /images/Lyudmil_Dachev-work-p-1600.avif 1600w, /images/Lyudmil_Dachev-work-p-2000.avif 2000w, /images/Lyudmil_Dachev-work.avif 2560w"
        alt="Grid of brand identity and web design projects by Lyudmil Dachev"
        class="img-works"
      >
    </div>
    <div class="grid">
      <div class="links-tt-wrap tt-link-grid">
        <a href="https://www.behance.net/iam314" aria-label="View work archive" target="_blank" class="p-link-tt">Work archive ↗</a>
      </div>
    </div>
  </section>
  <section class="wrap">
    <div class="grid">
      <div class="cv-item cv-grid">
        <h2 class="txt-xl">Curriculum Vitae</h2>
        <ul role="list" class="list w-list-unstyled">
          <li class="list-item">
            <div class="txt-m">Those Things Studio<br><span class="txt-smaller">Design Director / Co Founder</span></div>
          </li>
          <li class="list-item">
            <div class="txt-m">Melon / Kin + Carta<br><span class="txt-smaller">UI/UX Designer</span></div>
          </li>
          <li class="list-item">
            <div class="txt-m">314<br><span class="txt-smaller">Solopreneur / Freelance</span></div>
          </li>
          <li class="list-item">
            <div class="txt-m">Barouh and Partners<br><span class="txt-smaller">Senior Graphic Designer</span></div>
          </li>
          <li class="list-item">
            <div class="txt-m">DDB Sofia<br><span class="txt-smaller">Graphic Designer</span></div>
          </li>
          <li class="list-item">
            <div class="txt-m">Edno Magazine<br><span class="txt-smaller">Assistant Designer</span></div>
          </li>
        </ul>
      </div>
    </div>
    <div class="grid">
      <div class="txt-item story-grid">
        <p class="paragraph">My journey into the visual arts began in my teens because of my involvement in skating and other counter-culture activities like graffiti, photography, and videography. At 15, a friend and I channeled our passion by starting a clothing company focused on skate apparel. This was my first encounter with graphic software, and I was instantly hooked. Over the next few years, we created unique designs, built multiple iterations of the company’s website, and produced skating videos. I wanted to explore and learn more, so I pursued a bachelor’s degree in visual communication, followed by a master’s program specialising in poster design and visual communication. I’ve worked as a freelancer, in-house, and at startups and established companies, gaining a diverse set of skills across multiple disciplines.</p>
      </div>
    </div>
    <div class="grid">
      <div class="feat-items feat-grid">
        <p class="txt-m">Awards and Features</p>
        <ul role="list" class="feat-list w-list-unstyled">
          <li class="list_item-awards">
            <div class="af-list-item">Webflow Partner</div>
          </li>
          <li class="list_item-awards">
            <div class="af-list-item">Event Pro Forum <br>Shaping the Future of Sustainable Events<br>panelist</div>
          </li>
          <li class="list_item-awards">
            <div class="af-list-item">The Other Half<br>My other Job is<br>group exhibition</div>
          </li>
          <li class="list_item-awards">
            <div class="af-list-item">Computer Space Forum <br>Best web design in the category - Society and Institutions<br>award</div>
          </li>
          <li class="list_item-awards">
            <div class="af-list-item">Adobe Creative Cloud<br>Designing with Aaron Draplin and Mama’s Sauce Print<br>featured work</div>
          </li>
          <li class="list_item-awards">
            <div class="af-list-item">A’ Design Awards<br>featured work<br></div>
          </li>
          <li class="list_item-awards">
            <div class="af-list-item">The Museum of Avant-garde<br>featured work</div>
          </li>
          <li class="list_item-awards">
            <div class="af-list-item">Artbelow London<br>group exhibition</div>
          </li>
          <li class="list_item-awards">
            <div class="af-list-item">Art Gallery Irida<br>group exhibition</div>
          </li>
          <li class="list_item-awards">
            <div class="af-list-item">Art Gallery CC55<br>group exhibition</div>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
