---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import { getProductPage } from '../../data/productPages';

const payhipProduct = 'anoWZ';

const meta = {
  title: "314 blok — Latin & Cyrillic Block Display Typeface by Lyudmil Dachev",
  description: "314 blok is a raw block display typeface born from protest t-shirt lettering: 522 glyphs, Latin & Cyrillic, and OpenType features (ss01, locl, kern, aalt).",
  link: "https://www.iam314.com/store/314blok-font/",
  ogImage: "/images/ogimages/og-314-blok.png",
  price: "10",
  availability: "https://schema.org/InStock",
};

const { gallery, schema } = getProductPage('314blok-font');
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  link={meta.link}
  ogImage={meta.ogImage}
  schemaType="product"
  price={meta.price}
  availability={meta.availability}
  product={schema}
  footerVariant="inner"
>
    <section class="wrap inner-store-hero">
      <div class="grid">
        <div class="productgallery-grid">
          <ProductGallery items={gallery} label="314 blok display typeface specimens gallery" />
        </div>      
        <div class="productdecription-grid">
          <h1 class="txt-l">314 blok</h1>
          <p class="txt-s">€10</p>
          <p class="subtxtgray">Display font</p>
          <p class="paragraph1">This typeface started as a t-shirt design. A friend’s mum asked me to make one for her son’s birthday, with one word on it: “МРЪШЛЯК”. For context, it’s a misspelled Bulgarian word that refers to a political incident. It came out of a politician’s mouth during the anti government protests.</p>
          <p class="paragraph1">I drew letters that suited it perfectly. Imagine old Fiat block letters that had a baby with a punk rocker, and that baby went to an anti government protest. I liked these letters so much I had to turn them into a font.</p>
          <p class="paragraph1">Welcome to the eastern blok.</p>
          <p class="paragraph1">
            1 style<br>
            522 unique glyphs<br>
            Latin and Cyrillic<br>
            OpenType features: ss01, locl, kern, aalt<br>
            Supports the Latin and Cyrillic scripts, including English, German, French, Spanish, Bulgarian, and more.</p>
          <div class="buttons">
            <a href={`https://payhip.com/b/${payhipProduct}?redirect=https://iam314.com/thanks/`}
              class="add-btn payhip-add-to-cart-button"
              data-theme="none"
              data-product={payhipProduct}>
              Add to cart
            </a>
            <button type="button"
              class="buy-btn buy-now-btn"
              data-product={payhipProduct}
              data-message="Thanks for buying 314 blok!"
              data-title="314 blok – font"
            >Buy
            </button>
          </div>
        </div>
      </div>
    </section>
<Faq />

</BaseLayout>
