---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';

const meta = {
  title: "314 bits — Geometric Display Typeface (575 Glyphs) by Lyudmil Dachev",
  description: "314 Bits is a geometric display typeface developed from 2009–2024. Includes 575 glyphs and OpenType features (aalt, salt, ss01, subs, sups). Instant download.",
  link: "https://www.iam314.com/store/314bits-font/",
  ogImage: "/images/ogimages/og-314-bits.png",
  price: "12",
  availability: "https://schema.org/InStock",
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  link={meta.link}
  ogImage={meta.ogImage}
  schemaType="product"
  price={meta.price}
  availability={meta.availability}
  useSwiper
  footerVariant="inner"
>
    <section class="wrap inner-store-hero">
      <div class="grid">
        <div class="productgallery-grid">
          <div class="product-gallery">
            <!-- Thumbnail slider -->
            <div class="swiper product-thumbs">
              <div class="swiper-wrapper">
                <!-- <div class="swiper-slide">
                  <img src="/images/store/314bits/314bits_1.avif" alt="Image that says Hi in the 3 weights of the font" loading="lazy">
                </div> -->
                <div class="swiper-slide">
                  <img src="/images/store/314bits/314bits_2.avif" alt="314 bits display typeface specimen showing capital letter A in regular weight" loading="lazy">
                </div>
                <div class="swiper-slide">
                  <img src="/images/store/314bits/314bits_3.avif" alt="314 bits display typeface specimen showing upper and lower case letters in regular weight" loading="lazy">
                </div>
                <div class="swiper-slide">
                  <img src="/images/store/314bits/314bits_4.avif" alt="314 bits display typeface specimen showing capital letter A in striked weight" loading="lazy">
                </div>
                <div class="swiper-slide">
                  <img src="/images/store/314bits/314bits_5.avif" alt="314 bits display typeface specimen showing upper and lower case letters in striked weight" loading="lazy">
                </div>
                <div class="swiper-slide">
                  <img src="/images/store/314bits/314bits_6.avif" alt="314 bits display typeface specimen showing capital letter A in hand weight" loading="lazy">
                </div>
                <div class="swiper-slide">
                  <img src="/images/store/314bits/314bits_7.avif" alt="314 bits display typeface specimen showing upper and lower case letters in hand weight" loading="lazy">
                </div>                                                                
              </div>
            </div>
            <!-- Main slider -->
            <div class="swiper product-main">
              <div class="swiper-wrapper">
                <!-- <div class="swiper-slide">
                  <img src="/images/store/314bits/314bits_1.avif" alt="Image that says Hi in the 3 weights of the font" loading="lazy">
                </div> -->
                <div class="swiper-slide">
                  <img src="/images/store/314bits/314bits_2.avif" alt="314 bits display typeface specimen showing capital letter A in regular weight" loading="lazy">
                </div>
                <div class="swiper-slide">
                  <img src="/images/store/314bits/314bits_3.avif" alt="314 bits display typeface specimen showing upper and lower case letters in regular weight" loading="lazy">
                </div>
                <div class="swiper-slide">
                  <img src="/images/store/314bits/314bits_4.avif" alt="314 bits display typeface specimen showing capital letter A in striked weight" loading="lazy">
                </div>
                <div class="swiper-slide">
                  <img src="/images/store/314bits/314bits_5.avif" alt="314 bits display typeface specimen showing upper and lower case letters in striked weight" loading="lazy">
                </div>
                <div class="swiper-slide">
                  <img src="/images/store/314bits/314bits_6.avif" alt="314 bits display typeface specimen showing capital letter A in hand weight" loading="lazy">
                </div>
                <div class="swiper-slide">
                  <img src="/images/store/314bits/314bits_7.avif" alt="314 bits display typeface specimen showing upper and lower case letters in hand weight" loading="lazy">
                </div>                                                
              </div>
            </div>
          </div>
        </div>      
        <div class="productdecription-grid">
          <h1 class="txt-l">314 bits</h1>
          <p class="txt-s">€12</p>
          <p class="subtxtgray">Display font</p>
          <p class="paragraph1">Started in 2009 and completed in 2024, 314 bits is a display typeface shaped over time. What began as a personal experiment evolved into a full character set.</p>
          <p class="paragraph1">
            3 weights<br>
            575 unique glyphs of each weight<br>
            OpenType features: aalt, kern, locl, ordn, salt, ss01, subs, sups,<br>
            Supports 100+ Latin-based languages including English, German, French, Spanish, Bulgarian, and more.</p>
          <div class="buttons">
            <a href="https://payhip.com/b/i4xct?redirect=https://iam314.com/thanks/"
              class="add-btn payhip-add-to-cart-button"
              data-theme="none"
              data-product="i4xct"
              >
              Add to cart
            </a>
            <button type="button"
              class="buy-btn buy-now-btn"
              data-product="i4xct"
              data-message="Thanks for buying 314 bits!"
              data-title="314 bits – font bundle"
            >Buy
            </button>
          </div>
        </div>
      </div>
    </section>
<Faq />

<!-- STORE -->
  <script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".buy-now-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        Payhip.Checkout.open({
          product: btn.dataset.product,
          method: "overlay",
          message: btn.dataset.message,
          title: btn.dataset.title,
          successUrl: "https://iam314.com/thanks/"
        });
      });
    });
  });
  </script>

<!-- SWIPER -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    // Thumbnails
const thumbsSwiper = new Swiper('.product-thumbs', {
  spaceBetween: 8,
  freeMode: true,
  watchSlidesProgress: true,

  // default (desktop)
  direction: 'vertical',
  slidesPerView: 'auto',

  breakpoints: {
    0: {
      direction: 'horizontal',
      slidesPerView: 'auto'
    },
    767: {
      direction: 'vertical',
      slidesPerView: 'auto'
    }
  }
});

    // Main slider with thumbs
    const mainSwiper = new Swiper('.product-main', {
      spaceBetween: 16,
      loop: true,
      grabCursor: true,
      thumbs: {
        swiper: thumbsSwiper
      }
    });
  });
</script>
</BaseLayout>
