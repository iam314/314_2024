---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cta from '../../components/CTA.astro';

const meta = {
  title: "Fotofabrika — Website Design & Development by Lyudmil Dachev",
  description: "Website design and development for Fotofabrika Foundation, a photography foundation and events space in Sofia. Light and dark theme by Lyudmil Dachev.",
  link: "https://www.iam314.com/work/fotofabrika/",
  ogImage: "/images/ogimages/og-fotofabrika.png",
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  link={meta.link}
  ogImage={meta.ogImage}
  schemaType="case-study"
  footerVariant="photoOnly"
>
  <section class="wrap">
    <div class="grid">
      <div class="inner-projects-hero hero-grid projects-top-reset">
        <h1 class="txt-xl">Fotofabrika</h1>
        <h2 style="margin-bottom: 0;" class="subtxt">Website Design & Development</h2>
          <ul class="labels">
            <li class="labels subtxtgray">UI/UX</li>
            <li class="labels subtxtgray">Web design</li>
            <li class="labels subtxtgray">Development</li>
            <li class="labels subtxtgray">Webflow</li>
          </ul>
      </div>
    </div>
  </section>
  <section class="wrap">
    <div class="grid inner-projects-hero marging-reset">
      <div class="projects-grid">
        <div class="grid-1">

          <figure>
            <img class="img-responsive" src="/images/work/fotofabrika/fotofabrika_website-home_page.gif" 
                 alt="Fotofabrika website homepage interaction and scrolling experience" 
                 loading="lazy" width="2560" height="1440">
            <figcaption class="visually-hidden">
              A scrolling showcase of the Fotofabrika Foundation homepage, highlighting the minimalist grid and photography-centric layout.
            </figcaption>
          </figure>

          <figure>
            <img class="img-responsive" src="/images/work/fotofabrika/fotofabrika-website-pages-light.avif" 
                 alt="Light mode UI design for Fotofabrika website" 
                 loading="lazy" width="2560" height="2210">
            <figcaption class="visually-hidden">
              Interior page designs for the Fotofabrika website showcased in a clean, high-contrast light theme.
            </figcaption>
          </figure>

          <figure>
            <img class="img-responsive" src="/images/work/fotofabrika/fotofabrika_pages_mobile-light.gif" 
                 alt="Mobile responsive design for Fotofabrika in light mode" 
                 loading="lazy" width="2560" height="915">
            <figcaption class="visually-hidden">
              Responsive mobile interface for Fotofabrika, demonstrating seamless navigation on smaller screens in light mode.
            </figcaption>
          </figure>    

          <figure>
            <img class="img-responsive" src="/images/work/fotofabrika/fotofabrika-website-pages-dark.avif" 
                 alt="Dark mode UI design for Fotofabrika website" 
                 loading="lazy" width="2560" height="2222">
            <figcaption class="visually-hidden">
              Alternative dark mode visual system for the Fotofabrika platform, optimized for viewing photography in low-light environments.
            </figcaption>
          </figure>    

          <figure>
            <img class="img-responsive" src="/images/work/fotofabrika/fotofabrika_pages_mobile-dark.gif" 
                 alt="Mobile responsive design for Fotofabrika in dark mode" 
                 loading="lazy" width="2560" height="915">
            <figcaption class="visually-hidden">
              The dark mode mobile experience for Fotofabrika, maintaining aesthetic consistency across devices.
            </figcaption>
          </figure>                                    

        </div>
      </div>
    </div>
  </section> 

<!-- up next -->
  <section class="wrap">
    <a href="/work/crazy-frog/" class="upnext-link">
    <div class="grid">
      <div class="inner-projects-hero hero-grid projects-top-reset">
        <h3 class="subtxt subtxtgray">up next</h3>
        <h4 class="txt-xl">Crazy Frog</h4>
        <h5 class="subtxt">Identity & Website</h5>
          <ul class="labels">
            <li class="labels subtxtgray">Logo design</li>
            <li class="labels subtxtgray">Identity</li>
            <li class="labels subtxtgray">UI/UX</li>
            <li class="labels subtxtgray">Shopify</li>
            <li class="labels subtxtgray">PWA</li>
          </ul>
      </div>
    </div>

    <div class="grid inner-projects-hero marging-reset">
      <div class="projects-grid" style="padding-bottom: 0;">
        <div class="grid-1">

          <div>
            <figure class="upnext-img">
            <lottie-player 
              src="/images/work/crazy-frog/crazy-frog_logo_animation.json" 
              background="#fafafa" 
              speed="1" 
              loop 
              autoplay 
              muted
              role="img"
              width="3840"
              height="2160"
              aria-label="Animated Crazy Frog logo by Lyudmil Dachev">
            </lottie-player>
            <figcaption class="visually-hidden">
              Animated brand mark for Crazy Frog, a children's retail brand, featuring playful motion design.
            </figcaption>
            </figure>
          </div>                                         

        </div>
      </div>
    </div>
    </a>
  </section>
<!-- end of upnext -->  

<Cta />
</BaseLayout>