---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';

const meta = {
  title: 'Work – Selected Projects by Lyudmil Dachev',
  description:
    'Brand identity, Webflow, and logo marks by Lyudmil Dachev. Case studies and selected projects from a solo design practice based in Sofia.',
  link: 'https://www.iam314.com/work/',
  ogImage: '/images/ogimages/og-work.png',
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  link={meta.link}
  ogImage={meta.ogImage}
  footerVariant="inner"
>
  <div class="visually-hidden">
    <h1>Work. Selected Projects by Lyudmil Dachev</h1>
    <p>Brand identity systems, Webflow builds, and logo marks by Lyudmil Dachev. Selected case studies from a solo practice based in Sofia, operating worldwide.</p>
  </div>
  <section class="wrap">
    <div class="grid inner-store-hero">
      <div class="products-grid">
        <ul role="list" class="w-list-unstyled grid-3">
          {
            projects.map((p) => (
              <li class="grid-item">
                <article>
                  <a class="product-links" href={'/work/' + p.slug + '/'} aria-label={p.aria}>
                    <div class="project-wrapper">
                      <div class="product-image">
                        <img class="img-responsive" loading="lazy" decoding="async" src={p.thumb} width={p.thumbWidth} height={p.thumbHeight} alt={p.thumbAlt}>
                      </div>
                    </div>
                    <div class="titleprice">
                      <h2 class="txt-smaller">{p.name}</h2>
                    </div>
                  </a>
                </article>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
